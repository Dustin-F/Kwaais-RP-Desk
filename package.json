{
  "name": "kwaais-rp-desk",
  "version": "1.0.0",
  "description": "KWAAI's RP DESK - PD, SD & Mechanic RP overlay for FiveM/GTA V",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/convert-icon.cjs",
    "build": "electron-builder"
  },
  "author": "KWAAI",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "png-to-ico": "^3.0.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.kwaais.rp.desk",
    "productName": "KWAAI's RP DESK",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Dustin-F",
      "repo": "Kwaais-RP-Desk"
    }
  }
}
